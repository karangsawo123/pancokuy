# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file `.env`.

# Koneksi PostgreSQL yang dipakai Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/pancokuy?schema=public"

# Secret untuk menandatangani sesi JWT Auth.js v5.
# Buat nilai acak dengan: npx auth secret
AUTH_SECRET=""

# URL dasar aplikasi. Di lokal biarkan seperti ini.
AUTH_URL="http://localhost:3000"

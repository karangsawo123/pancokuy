# Salin file ini menjadi `.env.local` lalu isi nilainya. JANGAN commit file `.env.local`.
# Ambil nilainya dari Supabase Dashboard -> Project Settings -> API.

# URL project Supabase.
NEXT_PUBLIC_SUPABASE_URL=""

# Publishable key (dulu disebut "anon key") - aman dipakai di browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (dulu disebut "service_role key") - HANYA untuk kode server-side
# (Route Handlers/Server Actions), melewati RLS. JANGAN pernah expose ke client.
SUPABASE_SECRET_KEY=""
